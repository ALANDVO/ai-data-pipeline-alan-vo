# AI Data Pipeline Orchestrator — Environment Configuration
# Copy to .env and fill in your values. Never commit .env.

# ===== Required for Production =====
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# LLM Configuration (optional — local fallbacks work without keys)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
LLM_PROVIDER=openai

# ===== Keycloak / OIDC =====
# Get from Keycloak Admin Console → Clients → pipeline-frontend → Credentials
OAUTH_CLIENT_ID=pipeline-frontend
OAUTH_CLIENT_SECRET=
# Must match Keycloak client redirect URI exactly
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Keycloak Admin (for realm import)
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_CLIENT_SECRET=changeme

# ===== Database =====
POSTGRES_PASSWORD=changeme
# For external DB, override:
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# POSTGRES_DB=analytics
# POSTGRES_USER=etl

# ===== Cloud Connectors (optional) =====
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=

# Google Cloud
GCS_BUCKET_NAME=
GCS_SERVICE_ACCOUNT_JSON=
BIGQUERY_PROJECT=
BIGQUERY_DATASET=

# ===== Demo User (Keycloak realm import) =====
DEMO_USER_PASSWORD=demo123

# ===== Server =====
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO